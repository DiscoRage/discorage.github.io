<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="repository.az2music" name="Arctic Zephyr 2: Music Edition Repository" version="1.0.0" provider-name="DiscoRage">
    <extension point="xbmc.addon.repository" name="Arctic Zephyr 2: Music Edition Repository">
        <!-- Kodi 21 (Omega). A Kodi 22 (Piers) <dir> can be added alongside later. -->
        <dir minversion="20.9.1" maxversion="21.9.0">
            <info compressed="false">https://discorage.github.io/omega/addons.xml</info>
            <checksum>https://discorage.github.io/omega/addons.xml.md5</checksum>
            <datadir zip="true">https://discorage.github.io/omega/</datadir>
            <hashes>sha256</hashes>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Arctic Zephyr 2: Music Edition and its companion add-ons.</summary>
        <description lang="en_GB">Installs and updates Arctic Zephyr 2: Music Edition, a music-first Arctic Zephyr 2 for Kodi, and the companion add-ons it uses. All other dependencies come from the official Kodi repository.</description>
        <platform>all</platform>
        <license>GPL-3.0-or-later</license>
        <source>https://github.com/DiscoRage/Arctic-Zephyr-2-Music-Edition</source>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
<addon id="skin.az2music" name="Arctic Zephyr 2: Music Edition" provider-name="DiscoRage, DenDyGH, heppen, pkscout, jurialmunkey" version="0.3.8">
    <!-- Every dependency resolves from the official Kodi (Omega) repository. -->
    <requires>
        <import addon="xbmc.gui" version="5.17.0" />
        <import addon="script.skinshortcuts"/>
        <import addon="script.skinvariables" version="2.1.28" />
        <import addon="plugin.video.themoviedb.helper" version="5.4.16" />
        <import addon="resource.images.studios.white"/>
        <import addon="resource.images.moviegenreicons.transparent"/>
        <import addon="resource.images.weathericons.white"/>
        <import addon="resource.images.moviecountryicons.maps"/>
    </requires>
    <extension point="xbmc.gui.skin" debugging="false" defaultthemename="Square.xbt" effectslowdown="1">
        <res width="1920" height="1080" aspect="16:9" default="true" folder="1080i" />
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">A music-first Arctic Zephyr 2, with full video support.</summary>
        <description lang="en_GB">Arctic Zephyr 2: Music Edition is a music-first version of Arctic Zephyr 2 for Kodi 21. It is based on Arctic Zephyr 2: Resurrection by DenDyGH and heppen, which builds on Arctic Zephyr 2 by jurialmunkey as ported to Kodi 19 by pkscout. Video playback and libraries work as in Resurrection.</description>
        <disclaimer lang="en_GB">Work in progress: test builds may change or break without notice.</disclaimer>
        <platform>all</platform>
        <license>CC-BY-NC-SA-4.0</license>
        <source>https://github.com/DiscoRage/Arctic-Zephyr-2-Music-Edition</source>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
</addons>
